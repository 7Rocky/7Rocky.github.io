&lt;span class="mtk1"> &lt;/span>&lt;span class="mtk7 mtki">let&lt;/span>&lt;span class="mtk1"> a&lt;/span>&lt;span class="mtk5">:&lt;/span>&lt;span class="mtk1"> &lt;/span>&lt;span class="mtk8 mtku">i32&lt;/span>&lt;span class="mtk1"> &lt;/span>&lt;span class="mtk5">=&lt;/span>&lt;span class="mtk1"> input&lt;/span>&lt;span class="mtk5">.&lt;/span>&lt;span class="mtk8">trim&lt;/span>&lt;span class="mtk1">()&lt;/span>&lt;span class="mtk5">.&lt;/span>&lt;span class="mtk8">parse&lt;/span>&lt;span class="mtk1">()&lt;/span>&lt;span class="mtk5">.&lt;/span>&lt;span class="mtk8">expect&lt;/span>&lt;span class="mtk1">(&lt;/span>&lt;span class="mtk4">"Please enter a valid number"&lt;/span>&lt;span class="mtk1">);&lt;/span>

&lt;span class="mtk1"> input&lt;/span>&lt;span class="mtk5">.&lt;/span>&lt;span class="mtk8">clear&lt;/span>&lt;span class="mtk1">();&lt;/span>

&lt;span class="mtk1"> &lt;/span>&lt;span class="mtk8 mtku">io&lt;/span>&lt;span class="mtk5">::&lt;/span>&lt;span class="mtk8">stdin&lt;/span>&lt;span class="mtk1">()&lt;/span>
&lt;span class="mtk1"> &lt;/span>&lt;span class="mtk5">.&lt;/span>&lt;span class="mtk8">read_line&lt;/span>&lt;span class="mtk1">(&lt;/span>&lt;span class="mtk5">&amp;amp;mut&lt;/span>&lt;span class="mtk1"> input)&lt;/span>
&lt;span class="mtk1"> &lt;/span>&lt;span class="mtk5">.&lt;/span>&lt;span class="mtk8">expect&lt;/span>&lt;span class="mtk1">(&lt;/span>&lt;span class="mtk4">"Failed to read line"&lt;/span>&lt;span class="mtk1">);&lt;/span>

&lt;span class="mtk1"> &lt;/span>&lt;span class="mtk7 mtki">let&lt;/span>&lt;span class="mtk1"> b&lt;/span>&lt;span class="mtk5">:&lt;/span>&lt;span class="mtk1"> &lt;/span>&lt;span class="mtk8 mtku">i32&lt;/span>&lt;span class="mtk1"> &lt;/span>&lt;span class="mtk5">=&lt;/span>&lt;span class="mtk1"> input&lt;/span>&lt;span class="mtk5">.&lt;/span>&lt;span class="mtk8">trim&lt;/span>&lt;span class="mtk1">()&lt;/span>&lt;span class="mtk5">.&lt;/span>&lt;span class="mtk8">parse&lt;/span>&lt;span class="mtk1">()&lt;/span>&lt;span class="mtk5">.&lt;/span>&lt;span class="mtk8">expect&lt;/span>&lt;span class="mtk1">(&lt;/span>&lt;span class="mtk4">"Please enter a valid number"&lt;/span>&lt;span class="mtk1">);&lt;/span>

&lt;span class="mtk3"> // calculate answer&lt;/span>
&lt;span class="mtk1"> &lt;/span>&lt;span class="mtk7 mtki">let&lt;/span>&lt;span class="mtk1"> answer &lt;/span>&lt;span class="mtk5">=&lt;/span>&lt;span class="mtk1"> a &lt;/span>&lt;span class="mtk5">+&lt;/span>&lt;span class="mtk1"> b;&lt;/span>

&lt;span class="mtk3"> // print answer&lt;/span>
&lt;span class="mtk1"> &lt;/span>&lt;span class="mtk8">println!&lt;/span>&lt;span class="mtk1">(&lt;/span>&lt;span class="mtk4">"{}"&lt;/span>&lt;span class="mtk1">, answer);&lt;/span>
&lt;span class="mtk1">}&lt;/span>
