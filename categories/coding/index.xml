&lt;span class="mtk1"> &lt;/span>&lt;span class="mtk8 mtku">io&lt;/span>&lt;span class="mtk5">::&lt;/span>&lt;span class="mtk8">stdin&lt;/span>&lt;span class="mtk1">()&lt;/span>
&lt;span class="mtk1"> &lt;/span>&lt;span class="mtk5">.&lt;/span>&lt;span class="mtk8">read_line&lt;/span>&lt;span class="mtk1">(&lt;/span>&lt;span class="mtk5">&amp;amp;mut&lt;/span>&lt;span class="mtk1"> input)&lt;/span>
