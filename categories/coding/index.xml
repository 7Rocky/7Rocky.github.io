 &lt;div class="highlight">
 &lt;code class="ma0 pa0 white">
 &lt;pre class="ccode" tabindex="0">
&lt;span class="mtk5">#include&lt;/span>&lt;span class="mtk1"> &lt;/span>&lt;span class="mtk4">&amp;lt;iostream&amp;gt;&lt;/span>

&lt;span class="mtk7 mtki">int&lt;/span>&lt;span class="mtk1"> &lt;/span>&lt;span class="mtk8">main&lt;/span>&lt;span class="mtk1">() {&lt;/span>
&lt;span class="mtk3"> // take in the numbers&lt;/span>
&lt;span class="mtk1"> &lt;/span>&lt;span class="mtk7 mtki">int&lt;/span>&lt;span class="mtk1"> a;&lt;/span>
&lt;span class="mtk1"> &lt;/span>&lt;span class="mtk7 mtki">int&lt;/span>&lt;span class="mtk1"> b;&lt;/span>
&lt;span class="mtk1"> &lt;/span>&lt;span class="mtk8 mtku">std&lt;/span>&lt;span class="mtk1">::cin &lt;/span>&lt;span class="mtk5">&amp;gt;&amp;gt;&lt;/span>&lt;span class="mtk1"> a;&lt;/span>
&lt;span class="mtk1"> &lt;/span>&lt;span class="mtk8 mtku">std&lt;/span>&lt;span class="mtk1">::cin &lt;/span>&lt;span class="mtk5">&amp;gt;&amp;gt;&lt;/span>&lt;span class="mtk1"> b;&lt;/span>

&lt;span class="mtk3"> // calculate answer&lt;/span>
&lt;span class="mtk1"> &lt;/span>&lt;span class="mtk7 mtki">int&lt;/span>&lt;span class="mtk1"> answer &lt;/span>&lt;span class="mtk5">=&lt;/span>&lt;span class="mtk1"> a &lt;/span>&lt;span class="mtk5">+&lt;/span>&lt;span class="mtk1"> b;&lt;/span>

&lt;span class="mtk3"> // print answer&lt;/span>
&lt;span class="mtk1"> &lt;/span>&lt;span class="mtk8 mtku">std&lt;/span>&lt;span class="mtk1">::cout &lt;/span>&lt;span class="mtk5">&amp;lt;&amp;lt;&lt;/span>&lt;span class="mtk1"> answer &lt;/span>&lt;span class="mtk5">&amp;lt;&amp;lt;&lt;/span>&lt;span class="mtk1"> &lt;/span>&lt;span class="mtk8 mtku">std&lt;/span>&lt;span class="mtk1">::endl;&lt;/span>

&lt;span class="mtk1"> &lt;/span>&lt;span class="mtk5">return&lt;/span>&lt;span class="mtk1"> &lt;/span>&lt;span class="mtk6">0&lt;/span>&lt;span class="mtk1">;&lt;/span>
&lt;span class="mtk1">}&lt;/span>
