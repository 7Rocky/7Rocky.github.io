&lt;h3 id="rust"&gt;Rust&lt;/h3&gt;
 &lt;div class="code-container" style="position: relative;"&gt;
 &lt;div class="highlight" data-pagefind-ignore="all"&gt;
 &lt;code class="ma0 pa0 white"&gt;
 &lt;pre class="ccode" tabindex="0"&gt;
&lt;span class="mtk5"&gt;use&lt;/span&gt;&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk8 mtku"&gt;std&lt;/span&gt;&lt;span class="mtk5"&gt;::&lt;/span&gt;&lt;span class="mtk1"&gt;io;&lt;/span&gt;

&lt;span class="mtk5"&gt;fn&lt;/span&gt;&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk8"&gt;main&lt;/span&gt;&lt;span class="mtk1"&gt;() {&lt;/span&gt;
&lt;span class="mtk3"&gt; // take in the numbers&lt;/span&gt;
&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk7 mtki"&gt;let&lt;/span&gt;&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk5"&gt;mut&lt;/span&gt;&lt;span class="mtk1"&gt; input &lt;/span&gt;&lt;span class="mtk5"&gt;=&lt;/span&gt;&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk8 mtku"&gt;String&lt;/span&gt;&lt;span class="mtk5"&gt;::&lt;/span&gt;&lt;span class="mtk8"&gt;new&lt;/span&gt;&lt;span class="mtk1"&gt;();&lt;/span&gt;

&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk8 mtku"&gt;io&lt;/span&gt;&lt;span class="mtk5"&gt;::&lt;/span&gt;&lt;span class="mtk8"&gt;stdin&lt;/span&gt;&lt;span class="mtk1"&gt;()&lt;/span&gt;
&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk5"&gt;.&lt;/span&gt;&lt;span class="mtk8"&gt;read_line&lt;/span&gt;&lt;span class="mtk1"&gt;(&lt;/span&gt;&lt;span class="mtk5"&gt;&amp;amp;mut&lt;/span&gt;&lt;span class="mtk1"&gt; input)&lt;/span&gt;
&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk5"&gt;.&lt;/span&gt;&lt;span class="mtk8"&gt;expect&lt;/span&gt;&lt;span class="mtk1"&gt;(&lt;/span&gt;&lt;span class="mtk4"&gt;"Failed to read line"&lt;/span&gt;&lt;span class="mtk1"&gt;);&lt;/span&gt;

&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk7 mtki"&gt;let&lt;/span&gt;&lt;span class="mtk1"&gt; a&lt;/span&gt;&lt;span class="mtk5"&gt;:&lt;/span&gt;&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk8 mtku"&gt;i32&lt;/span&gt;&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk5"&gt;=&lt;/span&gt;&lt;span class="mtk1"&gt; input&lt;/span&gt;&lt;span class="mtk5"&gt;.&lt;/span&gt;&lt;span class="mtk8"&gt;trim&lt;/span&gt;&lt;span class="mtk1"&gt;()&lt;/span&gt;&lt;span class="mtk5"&gt;.&lt;/span&gt;&lt;span class="mtk8"&gt;parse&lt;/span&gt;&lt;span class="mtk1"&gt;()&lt;/span&gt;&lt;span class="mtk5"&gt;.&lt;/span&gt;&lt;span class="mtk8"&gt;expect&lt;/span&gt;&lt;span class="mtk1"&gt;(&lt;/span&gt;&lt;span class="mtk4"&gt;"Please enter a valid number"&lt;/span&gt;&lt;span class="mtk1"&gt;);&lt;/span&gt;

&lt;span class="mtk1"&gt; input&lt;/span&gt;&lt;span class="mtk5"&gt;.&lt;/span&gt;&lt;span class="mtk8"&gt;clear&lt;/span&gt;&lt;span class="mtk1"&gt;();&lt;/span&gt;

&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk8 mtku"&gt;io&lt;/span&gt;&lt;span class="mtk5"&gt;::&lt;/span&gt;&lt;span class="mtk8"&gt;stdin&lt;/span&gt;&lt;span class="mtk1"&gt;()&lt;/span&gt;
&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk5"&gt;.&lt;/span&gt;&lt;span class="mtk8"&gt;read_line&lt;/span&gt;&lt;span class="mtk1"&gt;(&lt;/span&gt;&lt;span class="mtk5"&gt;&amp;amp;mut&lt;/span&gt;&lt;span class="mtk1"&gt; input)&lt;/span&gt;
&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk5"&gt;.&lt;/span&gt;&lt;span class="mtk8"&gt;expect&lt;/span&gt;&lt;span class="mtk1"&gt;(&lt;/span&gt;&lt;span class="mtk4"&gt;"Failed to read line"&lt;/span&gt;&lt;span class="mtk1"&gt;);&lt;/span&gt;

&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk7 mtki"&gt;let&lt;/span&gt;&lt;span class="mtk1"&gt; b&lt;/span&gt;&lt;span class="mtk5"&gt;:&lt;/span&gt;&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk8 mtku"&gt;i32&lt;/span&gt;&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk5"&gt;=&lt;/span&gt;&lt;span class="mtk1"&gt; input&lt;/span&gt;&lt;span class="mtk5"&gt;.&lt;/span&gt;&lt;span class="mtk8"&gt;trim&lt;/span&gt;&lt;span class="mtk1"&gt;()&lt;/span&gt;&lt;span class="mtk5"&gt;.&lt;/span&gt;&lt;span class="mtk8"&gt;parse&lt;/span&gt;&lt;span class="mtk1"&gt;()&lt;/span&gt;&lt;span class="mtk5"&gt;.&lt;/span&gt;&lt;span class="mtk8"&gt;expect&lt;/span&gt;&lt;span class="mtk1"&gt;(&lt;/span&gt;&lt;span class="mtk4"&gt;"Please enter a valid number"&lt;/span&gt;&lt;span class="mtk1"&gt;);&lt;/span&gt;

&lt;span class="mtk3"&gt; // calculate answer&lt;/span&gt;
&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk7 mtki"&gt;let&lt;/span&gt;&lt;span class="mtk1"&gt; answer &lt;/span&gt;&lt;span class="mtk5"&gt;=&lt;/span&gt;&lt;span class="mtk1"&gt; a &lt;/span&gt;&lt;span class="mtk5"&gt;+&lt;/span&gt;&lt;span class="mtk1"&gt; b;&lt;/span&gt;

&lt;span class="mtk3"&gt; // print answer&lt;/span&gt;
&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk8"&gt;println!&lt;/span&gt;&lt;span class="mtk1"&gt;(&lt;/span&gt;&lt;span class="mtk4"&gt;"{}"&lt;/span&gt;&lt;span class="mtk1"&gt;, answer);&lt;/span&gt;
&lt;span class="mtk1"&gt;}&lt;/span&gt;
&lt;/pre&gt;
 &lt;/code&gt;
