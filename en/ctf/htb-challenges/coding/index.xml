&lt;h3 id="python"&gt;Python&lt;/h3&gt;
 &lt;div class="code-container" style="position: relative;"&gt;
 &lt;div class="highlight" data-pagefind-ignore="all"&gt;
 &lt;code class="ma0 pa0 white"&gt;
 &lt;pre class="ccode" tabindex="0"&gt;
&lt;span class="mtk3"&gt;# take in the numbers&lt;/span&gt;
&lt;span class="mtk1"&gt;a&lt;/span&gt;&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk5"&gt;=&lt;/span&gt;&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk8 mtku"&gt;int&lt;/span&gt;&lt;span class="mtk1"&gt;(&lt;/span&gt;&lt;span class="mtk8"&gt;input&lt;/span&gt;&lt;span class="mtk1"&gt;())&lt;/span&gt;
&lt;span class="mtk1"&gt;b&lt;/span&gt;&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk5"&gt;=&lt;/span&gt;&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk8 mtku"&gt;int&lt;/span&gt;&lt;span class="mtk1"&gt;(&lt;/span&gt;&lt;span class="mtk8"&gt;input&lt;/span&gt;&lt;span class="mtk1"&gt;())&lt;/span&gt;

&lt;span class="mtk3"&gt;# calculate answer&lt;/span&gt;
&lt;span class="mtk1"&gt;answer&lt;/span&gt;&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk5"&gt;=&lt;/span&gt;&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk1"&gt;a&lt;/span&gt;&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk5"&gt;+&lt;/span&gt;&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk1"&gt;b&lt;/span&gt;

&lt;span class="mtk3"&gt;# print answer&lt;/span&gt;
&lt;span class="mtk8"&gt;print&lt;/span&gt;&lt;span class="mtk1"&gt;(&lt;/span&gt;&lt;span class="mtk1"&gt;answer&lt;/span&gt;&lt;span class="mtk1"&gt;)&lt;/span&gt;
&lt;/pre&gt;
 &lt;/code&gt;
 &lt;/div&gt;
