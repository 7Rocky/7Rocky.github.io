&lt;span class="mtk3"># take in the string&lt;/span>
&lt;span class="mtk1">s&lt;/span>&lt;span class="mtk1"> &lt;/span>&lt;span class="mtk5">=&lt;/span>&lt;span class="mtk1"> &lt;/span>&lt;span class="mtk8">input&lt;/span>&lt;span class="mtk1">()&lt;/span>

&lt;span class="mtk3"># calculate answer&lt;/span>
