&lt;h3 id="c-1"&gt;C++&lt;/h3&gt;
 &lt;div class="code-container" style="position: relative;"&gt;
 &lt;div class="highlight" data-pagefind-ignore="all"&gt;
 &lt;code class="ma0 pa0 white"&gt;
 &lt;pre class="ccode" tabindex="0"&gt;
&lt;span class="mtk5"&gt;#include&lt;/span&gt;&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk4"&gt;&amp;lt;iostream&amp;gt;&lt;/span&gt;

&lt;span class="mtk7 mtki"&gt;int&lt;/span&gt;&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk8"&gt;main&lt;/span&gt;&lt;span class="mtk1"&gt;() {&lt;/span&gt;
&lt;span class="mtk3"&gt; // take in the numbers&lt;/span&gt;
&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk7 mtki"&gt;int&lt;/span&gt;&lt;span class="mtk1"&gt; a;&lt;/span&gt;
&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk7 mtki"&gt;int&lt;/span&gt;&lt;span class="mtk1"&gt; b;&lt;/span&gt;
&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk8 mtku"&gt;std&lt;/span&gt;&lt;span class="mtk1"&gt;::cin &lt;/span&gt;&lt;span class="mtk5"&gt;&amp;gt;&amp;gt;&lt;/span&gt;&lt;span class="mtk1"&gt; a;&lt;/span&gt;
&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk8 mtku"&gt;std&lt;/span&gt;&lt;span class="mtk1"&gt;::cin &lt;/span&gt;&lt;span class="mtk5"&gt;&amp;gt;&amp;gt;&lt;/span&gt;&lt;span class="mtk1"&gt; b;&lt;/span&gt;

&lt;span class="mtk3"&gt; // calculate answer&lt;/span&gt;
&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk7 mtki"&gt;int&lt;/span&gt;&lt;span class="mtk1"&gt; answer &lt;/span&gt;&lt;span class="mtk5"&gt;=&lt;/span&gt;&lt;span class="mtk1"&gt; a &lt;/span&gt;&lt;span class="mtk5"&gt;+&lt;/span&gt;&lt;span class="mtk1"&gt; b;&lt;/span&gt;

&lt;span class="mtk3"&gt; // print answer&lt;/span&gt;
&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk8 mtku"&gt;std&lt;/span&gt;&lt;span class="mtk1"&gt;::cout &lt;/span&gt;&lt;span class="mtk5"&gt;&amp;lt;&amp;lt;&lt;/span&gt;&lt;span class="mtk1"&gt; answer &lt;/span&gt;&lt;span class="mtk5"&gt;&amp;lt;&amp;lt;&lt;/span&gt;&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk8 mtku"&gt;std&lt;/span&gt;&lt;span class="mtk1"&gt;::endl;&lt;/span&gt;

&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk5"&gt;return&lt;/span&gt;&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk6"&gt;0&lt;/span&gt;&lt;span class="mtk1"&gt;;&lt;/span&gt;
&lt;span class="mtk1"&gt;}&lt;/span&gt;
&lt;/pre&gt;
 &lt;/code&gt;
