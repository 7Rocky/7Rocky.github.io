&lt;span class="mtk3"># print answer&lt;/span>
&lt;span class="mtk8">print&lt;/span>&lt;span class="mtk1">(&lt;/span>&lt;span class="mtk1">answer&lt;/span>&lt;span class="mtk1">)&lt;/span>
