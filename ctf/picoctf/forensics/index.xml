 &lt;div class="highlight" data-pagefind-ignore="all"&gt;
 &lt;code class="ma0 pa0 white"&gt;
 &lt;pre class="cconsole" tabindex="0"&gt;
&lt;span class="code-cyan"&gt;$&lt;/span&gt; &lt;span class="code-dark-green"&gt;zsteg&lt;/span&gt; &lt;span class="mtku"&gt;pico.flag.png&lt;/span&gt;
