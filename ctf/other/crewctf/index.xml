&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk8 mtku"&gt;bytes&lt;/span&gt;&lt;span class="mtk1"&gt;(&lt;/span&gt;&lt;span class="mtk1"&gt;choices&lt;/span&gt;&lt;span class="mtk1"&gt;(&lt;/span&gt;&lt;span class="mtk1"&gt;chars&lt;/span&gt;&lt;span class="mtk1"&gt;, &lt;/span&gt;&lt;span class="mtk9 mtki"&gt;k&lt;/span&gt;&lt;span class="mtk5"&gt;=&lt;/span&gt;&lt;span class="mtk1"&gt;L&lt;/span&gt;&lt;span class="mtk1"&gt;)),&lt;/span&gt;
&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk8 mtku"&gt;bytes&lt;/span&gt;&lt;span class="mtk1"&gt;(&lt;/span&gt;&lt;span class="mtk1"&gt;choices&lt;/span&gt;&lt;span class="mtk1"&gt;(&lt;/span&gt;&lt;span class="mtk1"&gt;chars&lt;/span&gt;&lt;span class="mtk1"&gt;, &lt;/span&gt;&lt;span class="mtk9 mtki"&gt;k&lt;/span&gt;&lt;span class="mtk5"&gt;=&lt;/span&gt;&lt;span class="mtk1"&gt;L&lt;/span&gt;&lt;span class="mtk1"&gt;)),&lt;/span&gt;
&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk8 mtku"&gt;bytes&lt;/span&gt;&lt;span class="mtk1"&gt;(&lt;/span&gt;&lt;span class="mtk1"&gt;choices&lt;/span&gt;&lt;span class="mtk1"&gt;(&lt;/span&gt;&lt;span class="mtk1"&gt;chars&lt;/span&gt;&lt;span class="mtk1"&gt;, &lt;/span&gt;&lt;span class="mtk9 mtki"&gt;k&lt;/span&gt;&lt;span class="mtk5"&gt;=&lt;/span&gt;&lt;span class="mtk1"&gt;L&lt;/span&gt;&lt;span class="mtk1"&gt;)),&lt;/span&gt;
