&lt;span class="mtk1"&gt; )&lt;/span&gt;
&lt;span class="mtk1"&gt; )&lt;/span&gt;

&lt;span class="mtk1"&gt;key&lt;/span&gt;&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk5"&gt;=&lt;/span&gt;&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk8"&gt;sha256&lt;/span&gt;&lt;span class="mtk1"&gt;(&lt;/span&gt;&lt;span class="mtk1"&gt;w&lt;/span&gt;&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk5"&gt;+&lt;/span&gt;&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk1"&gt;x&lt;/span&gt;&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk5"&gt;+&lt;/span&gt;&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk1"&gt;y&lt;/span&gt;&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk5"&gt;+&lt;/span&gt;&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk1"&gt;z&lt;/span&gt;&lt;span class="mtk1"&gt;).&lt;/span&gt;&lt;span class="mtk8"&gt;digest&lt;/span&gt;&lt;span class="mtk1"&gt;()&lt;/span&gt;
