&lt;span class="mtk1"&gt;L&lt;/span&gt;&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk5"&gt;=&lt;/span&gt;&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk6"&gt;3&lt;/span&gt;

