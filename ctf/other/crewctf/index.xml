&lt;span class="mtk1"&gt;ct&lt;/span&gt;&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk5"&gt;=&lt;/span&gt;&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk8 mtku"&gt;AES&lt;/span&gt;&lt;span class="mtk1"&gt;.&lt;/span&gt;&lt;span class="mtk8"&gt;new&lt;/span&gt;&lt;span class="mtk1"&gt;(&lt;/span&gt;&lt;span class="mtk1"&gt;k4&lt;/span&gt;&lt;span class="mtk1"&gt;, &lt;/span&gt;&lt;span class="mtk8 mtku"&gt;AES&lt;/span&gt;&lt;span class="mtk1"&gt;.&lt;/span&gt;&lt;span class="mtk1"&gt;MODE_ECB&lt;/span&gt;&lt;span class="mtk1"&gt;).&lt;/span&gt;&lt;span class="mtk8"&gt;encrypt&lt;/span&gt;&lt;span class="mtk1"&gt;(&lt;/span&gt;
&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk8 mtku"&gt;AES&lt;/span&gt;&lt;span class="mtk1"&gt;.&lt;/span&gt;&lt;span class="mtk8"&gt;new&lt;/span&gt;&lt;span class="mtk1"&gt;(&lt;/span&gt;&lt;span class="mtk1"&gt;k3&lt;/span&gt;&lt;span class="mtk1"&gt;, &lt;/span&gt;&lt;span class="mtk8 mtku"&gt;AES&lt;/span&gt;&lt;span class="mtk1"&gt;.&lt;/span&gt;&lt;span class="mtk1"&gt;MODE_ECB&lt;/span&gt;&lt;span class="mtk1"&gt;).&lt;/span&gt;&lt;span class="mtk8"&gt;encrypt&lt;/span&gt;&lt;span class="mtk1"&gt;(&lt;/span&gt;
&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk8 mtku"&gt;AES&lt;/span&gt;&lt;span class="mtk1"&gt;.&lt;/span&gt;&lt;span class="mtk8"&gt;new&lt;/span&gt;&lt;span class="mtk1"&gt;(&lt;/span&gt;&lt;span class="mtk1"&gt;k2&lt;/span&gt;&lt;span class="mtk1"&gt;, &lt;/span&gt;&lt;span class="mtk8 mtku"&gt;AES&lt;/span&gt;&lt;span class="mtk1"&gt;.&lt;/span&gt;&lt;span class="mtk1"&gt;MODE_ECB&lt;/span&gt;&lt;span class="mtk1"&gt;).&lt;/span&gt;&lt;span class="mtk8"&gt;encrypt&lt;/span&gt;&lt;span class="mtk1"&gt;(&lt;/span&gt;
