&lt;span class="mtk5"&gt;from&lt;/span&gt;&lt;span class="mtk1"&gt; proofofwork &lt;/span&gt;&lt;span class="mtk5"&gt;import&lt;/span&gt;&lt;span class="mtk1"&gt; challenge_proof_of_work&lt;/span&gt;

&lt;span class="mtk1"&gt;FLAG&lt;/span&gt;&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk5"&gt;=&lt;/span&gt;&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk8 mtku"&gt;os&lt;/span&gt;&lt;span class="mtk1"&gt;.&lt;/span&gt;&lt;span class="mtk1"&gt;environ&lt;/span&gt;&lt;span class="mtk1"&gt;.&lt;/span&gt;&lt;span class="mtk8"&gt;get&lt;/span&gt;&lt;span class="mtk1"&gt;(&lt;/span&gt;&lt;span class="mtk4"&gt;"FLAG"&lt;/span&gt;&lt;span class="mtk1"&gt;, &lt;/span&gt;&lt;span class="mtk4"&gt;"flag&lt;/span&gt;&lt;span class="mtk6"&gt;{FAKE_FLAG}&lt;/span&gt;&lt;span class="mtk4"&gt;"&lt;/span&gt;&lt;span class="mtk1"&gt;) &lt;/span&gt;&lt;span class="mtk5"&gt;if&lt;/span&gt;&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk4"&gt;"flag"&lt;/span&gt;&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk5"&gt;in&lt;/span&gt;&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk8 mtku"&gt;os&lt;/span&gt;&lt;span class="mtk1"&gt;.&lt;/span&gt;&lt;span class="mtk1"&gt;environ&lt;/span&gt;&lt;span class="mtk1"&gt;.&lt;/span&gt;&lt;span class="mtk8"&gt;get&lt;/span&gt;&lt;span class="mtk1"&gt;(&lt;/span&gt;&lt;span class="mtk4"&gt;"FLAG"&lt;/span&gt;&lt;span class="mtk1"&gt;,&lt;/span&gt;&lt;span class="mtk4"&gt;""&lt;/span&gt;&lt;span class="mtk1"&gt;) &lt;/span&gt;&lt;span class="mtk5"&gt;else&lt;/span&gt;&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk4"&gt;"flag&lt;/span&gt;&lt;span class="mtk6"&gt;{FAKE_FLAG}&lt;/span&gt;&lt;span class="mtk4"&gt;"&lt;/span&gt;


&lt;span class="mtk1"&gt; &lt;/span&gt;
&lt;span class="mtk7 mtki"&gt;def&lt;/span&gt;&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk8"&gt;main&lt;/span&gt;&lt;span class="mtk1"&gt;():&lt;/span&gt;
&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk8"&gt;print&lt;/span&gt;&lt;span class="mtk1"&gt;(&lt;/span&gt;&lt;span class="mtk4"&gt;"Welcome to the Spooky Safebox!"&lt;/span&gt;&lt;span class="mtk1"&gt;)&lt;/span&gt;
&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk5"&gt;if&lt;/span&gt;&lt;span class="mtk1"&gt; &lt;/span&gt;&lt;span class="mtk5"&gt;not&lt;/span&gt;&lt;span class="mtk1"&gt; challenge_proof_of_work():&lt;/span&gt;
